<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin require-restart="false">
    <id>com.nathan.gitlabmr.integration</id>
    <name>GitLab MR</name>
    <vendor url="https://gitlab.com">GitLab Integration</vendor>

    <description><![CDATA[
        <p>GitLab Integration Plugin for IntelliJ IDEA</p>
        <ul>
            <li>View and manage GitLab Merge Requests</li>
            <li>Support for GitLab REST API</li>
            <li>Seamless integration with IDEA's Git workflow</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <h3>Version 2.2.0</h3>
        <ul>
            <li>新增合并请求检查状态轮询功能：当 MR 处于检查中状态时自动轮询更新</li>
            <li>支持 checking、preparing、unchecked、approvals_syncing 等检查中状态识别</li>
            <li>新增 CHECKING("检查中") 状态，与"待合并"一并显示</li>
            <li>创建 MR 后自动跟踪状态直至检查完成</li>
            <li>版本控制机制防止旧请求覆盖新数据</li>
            <li>窗口关闭时自动清理所有轮询任务</li>
        </ul>
    ]]></change-notes>

    <!-- Please see https://plugins.jetbrains.com/docs/intellij/build-number-ranges.html -->
    <idea-version since-build="241" until-build="253.*"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends optional="true" config-file="gitlab-git.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window -->
        <toolWindow id="GitLab" anchor="bottom" factoryClass="com.nathan.gitlabmr.toolwindow.GitLabToolWindowFactory"
                    icon="/icons/gitlab.svg" order="last"/>

        <!-- Application Settings -->
        <applicationConfigurable instance="com.nathan.gitlabmr.config.GitLabConfigurable" displayName="GitLab Settings"/>

        <!-- Project Settings -->
        <projectConfigurable instance="com.nathan.gitlabmr.config.GitLabProjectConfigurable" displayName="GitLab Project Settings"/>

        <!-- Application Services -->
        <applicationService id="com.nathan.gitlabmr.GitLabApplicationService"
                            serviceImplementation="com.nathan.gitlabmr.GitLabApplicationService"/>

        <!-- Project Services -->
        <projectService id="com.nathan.gitlabmr.GitLabProjectService"
                        serviceImplementation="com.nathan.gitlabmr.GitLabProjectService"/>

        <!-- Notification Group -->
        <notificationGroup id="GitLab.Notification.Group" displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- Add action group for the plugin -->
        <group id="GitLab.Toolbar" text="GitLab Actions">
            <action id="GitLab.Refresh" class="com.nathan.gitlabmr.actions.RefreshAction"
                    text="Refresh" description="Refresh GitLab data"
                    icon="AllIcons.Actions.Refresh"/>
            <action id="GitLab.AddServer" class="com.nathan.gitlabmr.actions.AddServerAction"
                    text="Add GitLab Server" description="Add a new GitLab server"
                    icon="AllIcons.General.Add"/>
            <separator/>
        </group>
    </actions>
</idea-plugin>
